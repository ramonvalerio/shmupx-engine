 }
 
 
+//-------------------------------------------------
+//  device_post_load - ShmupX: depois de carregar um
+//  estado, reaplica o que os callbacks ajustam fora
+//  do save state (clock do pump e volumes)
+//-------------------------------------------------
+
+void taito_en_device::device_post_load()
+{
+	if (m_old_clock != ~0U)
+		m_pump->set_unscaled_clock(m_old_clock);
+
+	for (int i = 0; i < 4; i++)
+		mb87078_gain_changed(i, m_mb87078->gain_percent_r(i));
+}
