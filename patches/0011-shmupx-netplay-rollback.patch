+// license:GPL-2.0-or-later
+// copyright-holders:ShmupX
+/***************************************************************************
+
+    shmupx_netplay_net.h
+
+    ShmupX Engine: o socket UDP da dupla online. Fica num arquivo à parte
+    (sem emu.h) para os cabeçalhos do Winsock não se misturarem com os do
+    emulador.
+
+***************************************************************************/
+
+#ifndef MAME_EMU_SHMUPX_NETPLAY_NET_H
+#define MAME_EMU_SHMUPX_NETPLAY_NET_H
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace shmupx_netplay::net {
+
+// endereço IPv4 e porta, na ordem do computador
+struct endpoint
+{
+	uint32_t ip = 0;
+	uint16_t port = 0;
+
+	bool valid() const { return ip != 0 && port != 0; }
+	bool operator==(const endpoint &rhs) const { return ip == rhs.ip && port == rhs.port; }
+	bool operator!=(const endpoint &rhs) const { return !(*this == rhs); }
+};
+
+// abre o socket UDP na porta (0 = qualquer uma); devolve a mensagem de erro se falhar
+bool open(uint16_t port, std::string &error);
+void close();
+uint16_t local_port();
+
+// envia um pacote (sem bloquear); a perda e o atraso simulados valem só para os testes
+bool send(const endpoint &to, const void *data, size_t size);
+
+// recebe um pacote se houver (sem bloquear): o tamanho, ou -1 se não houver nada
+int receive(endpoint &from, void *buffer, size_t size);
+
+// "1.2.3.4:5678" -> endereço (só IPv4 numérico ou nome resolvível)
+bool parse(const std::string &text, endpoint &out);
+std::vector<endpoint> parse_list(const std::string &text);
+std::string to_string(const endpoint &ep);
+
+// simulação de rede ruim nos testes entre dois motores: atraso de ida (ms), variação e perda (%)
+void simulate(int delay_ms, int jitter_ms, int loss_percent);
+
+// relógio em milissegundos (monotônico)
+uint32_t now_ms();
+// espera curta (microssegundos), com a resolução de 1 ms do Windows
+void sleep_us(int64_t us);
+// espera sem precisão, sem ocupar a CPU
+void idle_ms(int ms);
+
+} // namespace shmupx_netplay::net
+
+#endif // MAME_EMU_SHMUPX_NETPLAY_NET_H
