+
+//**************************************************************************
+//  UTILITÁRIOS
+//**************************************************************************
+
+uint32_t crc_of(const void *data, size_t size)
+{
+	uLong crc = crc32(0L, Z_NULL, 0);
+	const uint8_t *p = reinterpret_cast<const uint8_t *>(data);
+	while (size > 0)
+	{
+		uInt const n = uInt(std::min<size_t>(size, 1u << 30));
+		crc = crc32(crc, p, n);
+		p += n;
+		size -= n;
+	}
+	return uint32_t(crc);
+}
+
+// itens do save state que não mudam o jogo e diferem quando o quadro é refeito sem desenhar: a
+// posição do último desenho parcial da tela e os timers do Lua (plugins); ficam fora do CRC
+const char *const s_ignored_items[] = { "m_last_partial_scan", "lua_engine::" };
+std::vector<std::pair<size_t, size_t>> g_ignored_ranges;
+
+void find_ignored_ranges(running_machine &machine)
+{
+	g_ignored_ranges.clear();
+	size_t pos = 32;
+	for (int i = 0; i < machine.save().registration_count(); i++)
+	{
+		void *base;
+		u32 valsize, valcount, blockcount, stride;
+		const char *name = machine.save().indexed_item(i, base, valsize, valcount, blockcount, stride);
+		if (!name)
+			continue;
+		size_t const size = size_t(valsize) * valcount * blockcount;
+		for (const char *ignored : s_ignored_items)
+			if (std::strstr(name, ignored))
+			{
+				g_ignored_ranges.emplace_back(pos, size);
+				break;
+			}
+		pos += size;
+	}
+}
+
+bool ignored_item(const char *name)
+{
+	for (const char *ignored : s_ignored_items)
+		if (std::strstr(name, ignored))
+			return true;
+	return false;
+}
+
+// CRC do estado da máquina para comparar entre os dois motores (sem os itens ignorados)
+uint32_t state_crc(const std::vector<uint8_t> &state)
+{
+	uLong crc = crc32(0L, Z_NULL, 0);
+	size_t pos = 0;
+	for (auto const &[start, size] : g_ignored_ranges)
+	{
+		if (start > pos && start <= state.size())
+			crc = crc32(crc, state.data() + pos, uInt(start - pos));
+		pos = std::max(pos, start + size);
+	}
+	if (pos < state.size())
+		crc = crc32(crc, state.data() + pos, uInt(state.size() - pos));
+	return uint32_t(crc);
+}
+
+uint32_t crc_of_string(const std::string &text)
+{
+	return crc_of(text.data(), text.size());
+}
+
+int idx(int frame) { return frame & (HISTORY - 1); }
+
+void forgive_wait(int64_t us)
+{
+	if (us <= 0)
+		return;
+	osd_ticks_t const before = osd_ticks();
+	net::sleep_us(us);
+	g_forgiven_ticks += int64_t(osd_ticks() - before);
+}
+
+// espera sem precisão (conexão, transferência): dorme de verdade, sem ocupar a CPU
+void idle_wait()
+{
+	osd_ticks_t const before = osd_ticks();
+	net::idle_ms(2);
+	g_forgiven_ticks += int64_t(osd_ticks() - before);
+}
+
+// mantém a janela do jogo respondendo enquanto o laço espera (conexão, transferência, parceiro)
+void pump_window(bool force = false)
+{
+	uint32_t const now = net::now_ms();
+	if (force || now - g.last_pump_ms >= 16)
+	{
+		g.last_pump_ms = now;
+		g.machine->osd().update(true);
+	}
+}
+
+void end_session(const char *reason)
+{
+	if (g.mode != run_mode::NET || g.phase == phase_t::ENDED)
+		return;
+	emit("\"event\":\"ended\",\"reason\":\"%s\",\"frame\":%d", reason, g.frame);
+	g.phase = phase_t::ENDED;
+	g.machine->schedule_exit();
+}
+
+
+//**************************************************************************
+//  CAMPOS DE CONTROLE
+//**************************************************************************
+
+void build_fieldmap(running_machine &machine)
+{
+	g.fieldmap.clear();
+	g.local_fields.clear();
+	g.all_fields.clear();
+	g.joysticks.clear();
+
+	for (auto &port : machine.ioport().ports())
+		for (const ioport_field &field : port.second->fields())
+		{
+			g.all_fields.push_back(&field);
+			int slot = -1;
+			int bit = -1;
+			ioport_type const type = field.type();
+			if (type >= IPT_JOYSTICK_UP && type <= IPT_JOYSTICK_RIGHT && field.player() < 2)
+			{
+				slot = field.player();
+				bit = int(type - IPT_JOYSTICK_UP);
+			}
+			else if (type >= IPT_BUTTON1 && type <= IPT_BUTTON8 && field.player() < 2)
+			{
+				slot = field.player();
+				bit = 4 + int(type - IPT_BUTTON1);
+			}
+			else if (type == IPT_START1 || type == IPT_START2)
+			{
+				slot = (type == IPT_START1) ? 0 : 1;
+				bit = 12;
+			}
+			else if (type == IPT_COIN1 || type == IPT_COIN2)
+			{
+				slot = (type == IPT_COIN1) ? 0 : 1;
+				bit = 13;
+			}
+
+			if (slot >= 0)
+			{
+				g.fieldmap[&field] = uint16_t((slot << 8) | bit);
+				if (slot == 0)
+					g.local_fields.emplace_back(&field, uint16_t(1 << bit));
+			}
+			else
+			{
+				g.fieldmap[&field] = 0xffff;
+			}
+
+			if (field.live().joystick && std::find(g.joysticks.begin(), g.joysticks.end(), field.live().joystick) == g.joysticks.end())
+				g.joysticks.push_back(field.live().joystick);
+		}
+}
+
+uint16_t clean_socd(uint16_t in)
+{
+	if ((in & (BIT_UP | BIT_DOWN)) == (BIT_UP | BIT_DOWN))
+		in &= ~(BIT_UP | BIT_DOWN);
+	if ((in & (BIT_LEFT | BIT_RIGHT)) == (BIT_LEFT | BIT_RIGHT))
+		in &= ~(BIT_LEFT | BIT_RIGHT);
+	return in;
+}
+
+// controle do jogador local (os campos do jogador 1 dele), lido no fim do quadro anterior
+uint16_t sample_local(running_machine &machine)
+{
+	uint16_t in = 0;
+	for (auto const &[field, bit] : g.local_fields)
+		if (machine.input().seq_pressed(field->seq(SEQ_TYPE_STANDARD)))
+			in |= bit;
+	return clean_socd(in);
+}
+
+// entradas automáticas dos testes: ficha, start e depois movimento e tiro pseudoaleatórios
+uint16_t auto_input(int frame, int slot)
+{
+	int const f = frame % 3600;
+	int const coin_at = slot ? 80 : 60;
+	int const start_at = slot ? 170 : 150;
+	if (f >= coin_at && f < coin_at + 4)
+		return BIT_COIN;
+	if (f >= start_at && f < start_at + 4)
+		return BIT_START;
+	if (frame < 200)
+		return 0;
+	uint32_t h = uint32_t(frame / 7) * 2654435761u ^ uint32_t(slot + 1) * 40503u;
+	h ^= h >> 15; h *= 2246822519u; h ^= h >> 13; h *= 3266489917u; h ^= h >> 16;
+	uint16_t in = 0;
+	switch (h % 3) { case 1: in |= BIT_UP; break; case 2: in |= BIT_DOWN; break; }
+	switch ((h >> 4) % 3) { case 1: in |= BIT_LEFT; break; case 2: in |= BIT_RIGHT; break; }
+	if ((h >> 8) % 10 < 8) in |= BIT_BUTTON1;
+	if ((h >> 12) % 10 < 2) in |= BIT_BUTTON1 << 1;
+	if ((h >> 16) % 20 < 1) in |= BIT_BUTTON1 << 2;
+	return in;
+}
+
+// trava as entradas nas portas, como o ioport_manager::frame_update do VBLANK
+void latch(running_machine &machine, uint16_t p1, uint16_t p2)
+{
+	g.current[0] = p1;
+	g.current[1] = p2;
+
+	for (digital_joystick *joystick : g.joysticks)
+		joystick->frame_update();
+
+	for (auto &port : machine.ioport().ports())
+		port.second->update_defvalue(true);
+	for (auto &port : machine.ioport().ports())
+		port.second->update_defvalue(false);
+
+	for (auto &port : machine.ioport().ports())
+	{
+		port.second->frame_update();
+		ioport_value const newvalue = port.second->read();
+		for (dynamic_field &dynfield : port.second->live().writelist)
+			if (dynfield.field().type() != IPT_OUTPUT)
+				dynfield.write(newvalue);
+	}
+}
+
+
+//**************************************************************************
+//  ESTADOS DA MÁQUINA
+//**************************************************************************
+
+size_t compute_state_size(running_machine &machine)
+{
+	size_t total = 32;   // cabeçalho do save_manager
+	for (int i = 0; i < machine.save().registration_count(); i++)
+	{
+		void *base;
+		u32 valsize, valcount, blockcount, stride;
+		if (machine.save().indexed_item(i, base, valsize, valcount, blockcount, stride))
+			total += size_t(valsize) * valcount * blockcount;
+	}
+	return total;
+}
+
+bool save_into(running_machine &machine, std::vector<uint8_t> &buffer)
+{
+	buffer.resize(g.state_size);
+	return machine.save().write_buffer(buffer.data(), buffer.size()) == STATERR_NONE;
+}
+
+bool load_from(running_machine &machine, const std::vector<uint8_t> &buffer)
+{
+	return machine.save().read_buffer(buffer.data(), buffer.size()) == STATERR_NONE;
+}
+
+void save_slot(running_machine &machine, int frame)
+{
+	state_slot &slot = g.ring[frame % RING];
+	if (!save_into(machine, slot.data))
+	{
+		emit("\"event\":\"error\",\"reason\":\"save_failed\",\"frame\":%d", frame);
+		slot.frame = -1;
+		return;
+	}
+	slot.frame = frame;
+	slot.fields.resize(g.all_fields.size());
+	for (size_t i = 0; i < g.all_fields.size(); i++)
+		slot.fields[i] = field_live_copy{ g.all_fields[i]->live().impulse, g.all_fields[i]->live().last };
+}
+
+bool load_slot(running_machine &machine, int frame)
+{
+	state_slot &slot = g.ring[frame % RING];
+	if (slot.frame != frame || !load_from(machine, slot.data))
+		return false;
+	for (size_t i = 0; i < g.all_fields.size() && i < slot.fields.size(); i++)
+	{
+		g.all_fields[i]->live().impulse = slot.fields[i].impulse;
+		g.all_fields[i]->live().last = slot.fields[i].last;
+	}
+	return true;
+}
+
+// itens do save state que diferem entre dois estados (diagnóstico do SyncTest)
+std::string describe_difference(running_machine &machine, const std::vector<uint8_t> &a, const std::vector<uint8_t> &b)
+{
+	std::string result;
+	int found = 0;
+	size_t const n = std::min(a.size(), b.size());
+	if (n >= 32 && std::memcmp(a.data(), b.data(), 32) != 0)
+	{
+		result = "header";
+		found++;
+	}
+	size_t pos = 32;
+	for (int i = 0; i < machine.save().registration_count() && found < 8; i++)
+	{
+		void *base;
+		u32 valsize, valcount, blockcount, stride;
+		const char *name = machine.save().indexed_item(i, base, valsize, valcount, blockcount, stride);
+		if (!name)
+			continue;
+		size_t const size = size_t(valsize) * valcount * blockcount;
+		if (!ignored_item(name) && pos + size <= n && std::memcmp(a.data() + pos, b.data() + pos, size) != 0)
+		{
+			if (!result.empty())
+				result += ", ";
+			result += name;
+			found++;
+		}
+		pos += size;
+	}
+	// aspas e barras não podem ir para o JSON
+	std::replace(result.begin(), result.end(), '"', '\'');
+	std::replace(result.begin(), result.end(), '\\', '/');
+	return result;
+}
+
+
+//**************************************************************************
+//  EMULAÇÃO DE UM QUADRO
+//**************************************************************************
+
+void emulate_frame(running_machine &machine, bool resim, bool next_resim)
+{
+	g_resimulating = resim;
+	g_next_resimulated = next_resim;
+	g_frame_done = false;
+	while (!g_frame_done && !machine.exit_pending() && !machine.hard_reset_pending())
+		machine.scheduler().timeslice();
+	g_resimulating = false;
+	g_next_resimulated = false;
+}
+
+uint16_t remote_for(int frame)
+{
+	if (frame <= g.remote_last)
+		return g.remote[idx(frame)];
+	return g.remote_last >= 0 ? g.remote[idx(g.remote_last)] : 0;   // previsão: repete a última
+}
+
+uint16_t local_for(int frame)
+{
+	return frame <= g.local_last ? g.local[idx(frame)] : 0;
+}
+
+// quadro da dupla: guarda o estado, trava as entradas e emula
+void run_net_frame(running_machine &machine, int frame, bool resim, bool next_resim)
+{
+	save_slot(machine, frame);
+	uint16_t const mine = local_for(frame);
+	uint16_t const theirs = remote_for(frame);
+	g.used_remote[idx(frame)] = theirs;
+	if (g.slot == 0)
+		latch(machine, mine, theirs);
+	else
+		latch(machine, theirs, mine);
+	emulate_frame(machine, resim, next_resim);
+}
+
+void rollback(running_machine &machine, int from)
+{
+	if (from >= g.frame)
+		return;
+	if (!load_slot(machine, from))
+	{
+		emit("\"event\":\"error\",\"reason\":\"rollback_failed\",\"frame\":%d", from);
+		return;
+	}
+	int const depth = g.frame - from;
+	g.rollbacks++;
+	g.resimulated += depth;
+	g.max_rollback = std::max(g.max_rollback, depth);
+	for (int f = from; f < g.frame; f++)
+		run_net_frame(machine, f, true, f + 1 < g.frame);
+}
+
+
+//**************************************************************************
+//  REDE
+//**************************************************************************
+
+void send_packet(const writer &w)
+{
+	if (g.peer_locked)
+		net::send(g.peer, w.data(), w.size());
+	else
+		for (const net::endpoint &ep : g.candidates)
+			net::send(ep, w.data(), w.size());
+}
+
+void send_hello()
+{
+	writer w(PKT_HELLO, g.tag);
+	w.put8(uint8_t(g.slot));
+	w.put8(g.heard_peer ? 1 : 0);
+	w.put32(g.version);
+	w.put32(g.romhash);
+	char game[16] = { 0 };
+	std::strncpy(game, g.machine->system().name, sizeof(game) - 1);
+	w.put(game, sizeof(game));
+	w.put32(net::now_ms());
+	w.put32(g.echo_ts);
+	w.put16(uint16_t(std::min<uint32_t>(net::now_ms() - g.echo_recv_ms, 65535)));
+	send_packet(w);
+	g.last_hello_ms = net::now_ms();
+}
+
+void send_input()
+{
+	writer w(PKT_INPUT, g.tag);
+	int first = g.peer_ack + 1;
+	int count = std::clamp(g.local_last - first + 1, 0, MAX_INPUTS_PER_PACKET);
+	w.puti32(first);
+	w.put8(uint8_t(count));
+	for (int i = 0; i < count; i++)
+		w.put16(g.local[idx(first + i)]);
+	w.puti32(g.remote_last);
+	w.puti32(g.frame);
+	w.puti16(int16_t(std::clamp(g.local_adv * 100.0f, -30000.0f, 30000.0f)));
+	w.put32(net::now_ms());
+	w.put32(g.echo_ts);
+	w.put16(uint16_t(std::min<uint32_t>(net::now_ms() - g.echo_recv_ms, 65535)));
+
+	// o CRC confirmado mais recente
+	int crc_frame = -1;
+	uint32_t crc = 0;
+	if (!g.local_crc.empty())
+	{
+		auto last = g.local_crc.rbegin();
+		crc_frame = last->first;
+		crc = last->second;
+	}
+	w.puti32(crc_frame);
+	w.put32(crc);
+	send_packet(w);
+	g.last_input_send_ms = net::now_ms();
+}
+
+void update_rtt(uint32_t echo, uint16_t hold)
+{
+	if (echo == 0)
+		return;
+	int32_t const sample = int32_t(net::now_ms() - echo) - int32_t(hold);
+	if (sample < 0 || sample > 5000)
+		return;
+	if (!g.rtt_known)
+	{
+		g.rtt = float(sample);
+		g.rtt_known = true;
+	}
+	else
+	{
+		g.rtt = g.rtt * 0.9f + float(sample) * 0.1f;
+	}
+}
+
+void note_received(uint32_t ts)
+{
+	g.last_recv_ms = net::now_ms();
+	g.echo_ts = ts;
+	g.echo_recv_ms = g.last_recv_ms;
+	if (g.unstable_reported)
+	{
+		g.unstable_reported = false;
+		emit("\"event\":\"stable\"");
+	}
+}
+
+void handle_hello(reader &r, const net::endpoint &from)
+{
+	int const slot = r.get8();
+	bool const heard = r.get8() != 0;
+	uint32_t const version = r.get32();
+	uint32_t const romhash = r.get32();
+	const uint8_t *game = r.take(16);
+	uint32_t const ts = r.get32();
+	uint32_t const echo = r.get32();
+	uint16_t const hold = r.get16();
+	if (!r.ok())
+		return;
+
+	if (!g.peer_locked)
+	{
+		// o primeiro endereço que responde vale (LAN, IP público ou o que o NAT abriu)
+		g.peer = from;
+		g.peer_locked = true;
+	}
+	else if (from != g.peer)
+	{
+		// o NAT trocou a porta: segue o novo endereço (a chave da sessão já conferiu)
+		g.peer = from;
+	}
+
+	if (version != g.version)
+	{
+		emit("\"event\":\"ended\",\"reason\":\"version_mismatch\"");
+		g.phase = phase_t::ENDED;
+		g.machine->schedule_exit();
+		return;
+	}
+	char name[17] = { 0 };
+	std::memcpy(name, game, 16);
+	if (romhash != g.romhash || std::strncmp(name, g.machine->system().name, 16) != 0)
+	{
+		emit("\"event\":\"ended\",\"reason\":\"rom_mismatch\"");
+		g.phase = phase_t::ENDED;
+		g.machine->schedule_exit();
+		return;
+	}
+	if (slot == g.slot)
+	{
+		emit("\"event\":\"ended\",\"reason\":\"same_slot\"");
+		g.phase = phase_t::ENDED;
+		g.machine->schedule_exit();
+		return;
+	}
+
+	note_received(ts);
+	update_rtt(echo, hold);
+	bool const first = !g.heard_peer;
+	g.heard_peer = true;
+	g.peer_heard_us = g.peer_heard_us || heard;
+	// responde na hora: o parceiro mede o ping e sabe que foi ouvido
+	if (first || g.phase == phase_t::CONNECTING)
+		send_hello();
+}
+
+void check_misprediction(int frame)
+{
+	if (frame < g.frame && g.used_remote[idx(frame)] != g.remote[idx(frame)])
+		if (g.first_mispredicted < 0 || frame < g.first_mispredicted)
+			g.first_mispredicted = frame;
+}
+
+void start_resync(int reason_frame);
+
+void compare_crc(int frame)
+{
+	if (frame < g.crc_floor || g.xout.active || g.xin.active)
+		return;
+	auto const mine = g.local_crc.find(frame);
+	auto const theirs = g.remote_crc.find(frame);
+	if (mine == g.local_crc.end() || theirs == g.remote_crc.end() || frame <= g.last_checked_crc)
+		return;
+	g.last_checked_crc = frame;
+	if (mine->second != theirs->second)
+	{
+		g.desyncs++;
+		emit("\"event\":\"desync\",\"frame\":%d", frame);
+		if (g.slot == 0)
+			start_resync(frame);
+	}
+}
+
+void handle_input(reader &r)
+{
+	int const first = r.geti32();
+	int const count = r.get8();
+	uint16_t inputs[256];
+	for (int i = 0; i < count; i++)
+		inputs[i] = r.get16();
+	int const ack = r.geti32();
+	int const remote_frame = r.geti32();
+	int16_t const adv = r.geti16();
+	uint32_t const ts = r.get32();
+	uint32_t const echo = r.get32();
+	uint16_t const hold = r.get16();
+	int const crc_frame = r.geti32();
+	uint32_t const crc = r.get32();
+	if (!r.ok())
+		return;
+
+	note_received(ts);
+	update_rtt(echo, hold);
+
+	for (int i = 0; i < count; i++)
+	{
+		int const f = first + i;
+		if (f != g.remote_last + 1)
+			continue;
+		if (f - g.frame >= HISTORY / 2)
+			break;
+		g.remote[idx(f)] = inputs[i];
+		g.remote_last = f;
+		check_misprediction(f);
+	}
+	if (ack > g.peer_ack)
+		g.peer_ack = std::min(ack, g.local_last);
+	if (remote_frame > g.remote_frame)
+	{
+		g.remote_frame = remote_frame;
+		g.remote_frame_ms = net::now_ms();
+	}
+	g.remote_adv = g.remote_adv * 0.8f + (float(adv) / 100.0f) * 0.2f;
+
+	if (crc_frame >= 0 && crc_frame >= g.crc_floor)
+	{
+		g.remote_crc[crc_frame] = crc;
+		while (g.remote_crc.size() > 64)
+			g.remote_crc.erase(g.remote_crc.begin());
+		compare_crc(crc_frame);
+	}
+}
+
+
+//**************************************************************************
+//  TRANSFERÊNCIA DE ESTADO (começo da partida e ressincronia)
+//**************************************************************************
+
+bool begin_transfer(uint8_t purpose, int frame, const std::vector<uint8_t> &state)
+{
+	transfer_out &x = g.xout;
+	uLongf packed_size = compressBound(uLong(state.size()));
+	x.packed.resize(packed_size);
+	if (compress2(x.packed.data(), &packed_size, state.data(), uLong(state.size()), 1) != Z_OK)
+		return false;
+	x.packed.resize(packed_size);
+	x.active = true;
+	x.id = g.next_xfer_id++;
+	x.purpose = purpose;
+	x.frame = frame;
+	x.raw_size = uint32_t(state.size());
+	x.raw_crc = crc_of(state.data(), state.size());
+	x.count = int((x.packed.size() + CHUNK_BYTES - 1) / CHUNK_BYTES);
+	x.next = 0;
+	x.resend.clear();
+	x.last_send_ms = net::now_ms();
+	x.started_ms = x.last_send_ms;
+	emit("\"event\":\"state_send\",\"purpose\":\"%s\",\"frame\":%d,\"bytes\":%u,\"packed\":%u",
+			purpose == XFER_INITIAL ? "initial" : "resync", frame, x.raw_size, uint32_t(x.packed.size()));
+	return true;
+}
+
+void send_chunk(int index)
+{
+	transfer_out &x = g.xout;
+	writer w(PKT_STATE_CHUNK, g.tag);
+	w.put16(x.id);
+	w.put8(x.purpose);
+	w.puti32(x.frame);
+	w.put8(uint8_t(g.delay));
+	w.put32(x.raw_size);
+	w.put32(x.raw_crc);
+	w.put32(uint32_t(x.packed.size()));
+	w.put16(uint16_t(index));
+	w.put16(uint16_t(x.count));
+	size_t const offset = size_t(index) * CHUNK_BYTES;
+	size_t const size = std::min<size_t>(CHUNK_BYTES, x.packed.size() - offset);
+	w.put(x.packed.data() + offset, size);
+	send_packet(w);
+}
+
+// envia pedaços no ritmo de ~2 MB/s (uns 2 por ms), primeiro a passada completa e depois os pedidos de novo
+void pump_transfer()
+{
+	transfer_out &x = g.xout;
+	if (!x.active)
+		return;
+	uint32_t const now = net::now_ms();
+	int budget = std::clamp(int(now - x.last_send_ms) * 2, 1, 48);
+	x.last_send_ms = now;
+	while (budget > 0 && !x.resend.empty())
+	{
+		send_chunk(x.resend.back());
+		x.resend.pop_back();
+		budget--;
+	}
+	while (budget > 0 && x.next < x.count)
+	{
+		send_chunk(x.next++);
+		budget--;
+	}
+	// passada completa e o convidado sem responder: manda tudo de novo
+	if (x.next >= x.count && x.resend.empty() && now - x.started_ms > 3000 && now - g.last_recv_ms > 1000)
+	{
+		x.next = 0;
+		x.started_ms = now;
+	}
+}
+
+void handle_state_chunk(reader &r)
+{
+	uint16_t const id = r.get16();
+	uint8_t const purpose = r.get8();
+	int const frame = r.geti32();
+	int const delay = r.get8();
+	uint32_t const raw_size = r.get32();
+	uint32_t const raw_crc = r.get32();
+	uint32_t const packed_size = r.get32();
+	int const index = r.get16();
+	int const count = r.get16();
+	if (!r.ok() || g.slot != 1)
+		return;
+	g.last_recv_ms = net::now_ms();
+
+	transfer_in &x = g.xin;
+	if (id == x.done_id)
+	{
+		// o anfitrião não recebeu o DONE: repete
+		writer w(PKT_STATE_DONE, g.tag);
+		w.put16(id);
+		w.puti32(g.frame);
+		send_packet(w);
+		return;
+	}
+	if (!x.active || x.id != id)
+	{
+		if (raw_size != g.state_size || count == 0 || packed_size > uint32_t(count) * CHUNK_BYTES)
+		{
+			emit("\"event\":\"ended\",\"reason\":\"state_mismatch\"");
+			g.phase = phase_t::ENDED;
+			g.machine->schedule_exit();
+			return;
+		}
+		uint16_t const done_id = x.done_id;
+		x = transfer_in();
+		x.done_id = done_id;
+		x.active = true;
+		x.id = id;
+		x.purpose = purpose;
+		x.frame = frame;
+		x.delay = delay;
+		x.raw_size = raw_size;
+		x.raw_crc = raw_crc;
+		x.packed_size = packed_size;
+		x.count = count;
+		x.packed.assign(packed_size, 0);
+		x.have.assign(count, false);
+		x.last_ack_ms = net::now_ms();
+	}
+	if (index >= x.count || x.have[index])
+		return;
+	size_t const offset = size_t(index) * CHUNK_BYTES;
+	size_t const size = std::min<size_t>(CHUNK_BYTES, x.packed_size - offset);
+	const uint8_t *data = r.take(size);
+	if (!data)
+		return;
+	std::memcpy(x.packed.data() + offset, data, size);
+	x.have[index] = true;
+	x.received++;
+	if (x.received == x.count)
+		x.complete = true;
+}
+
+void send_state_ack()
+{
+	transfer_in &x = g.xin;
+	writer w(PKT_STATE_ACK, g.tag);
+	w.put16(x.id);
+	std::vector<uint16_t> missing;
+	for (int i = 0; i < x.count && missing.size() < 200; i++)
+		if (!x.have[i])
+			missing.push_back(uint16_t(i));
+	w.put16(uint16_t(missing.size()));
+	for (uint16_t m : missing)
+		w.put16(m);
+	send_packet(w);
+	x.last_ack_ms = net::now_ms();
+}
+
+void handle_state_ack(reader &r)
+{
+	uint16_t const id = r.get16();
+	int const n = r.get16();
+	if (!r.ok() || !g.xout.active || id != g.xout.id)
+		return;
+	g.last_recv_ms = net::now_ms();
+	// os pedaços que faltam e já passaram na primeira passada voltam para a fila
+	std::vector<uint16_t> missing;
+	for (int i = 0; i < n; i++)
+	{
+		uint16_t const m = r.get16();
+		if (r.ok() && m < g.xout.next)
+			missing.push_back(m);
+	}
+	std::reverse(missing.begin(), missing.end());
+	g.xout.resend = missing;
+}
+
+void handle_state_done(reader &r)
+{
+	uint16_t const id = r.get16();
+	int const guest_frame = r.geti32();
+	if (!r.ok() || !g.xout.active || id != g.xout.id)
+		return;
+	g.last_recv_ms = net::now_ms();
+	uint8_t const purpose = g.xout.purpose;
+	g.xout.active = false;
+	g.xout.packed.clear();
+	if (purpose == XFER_INITIAL && g.phase == phase_t::SYNC_SEND)
+	{
+		g.phase = phase_t::RUNNING;
+		emit("\"event\":\"running\",\"delay\":%d,\"rtt\":%d", g.delay, int(g.rtt + 0.5f));
+	}
+	else if (purpose == XFER_RESYNC)
+	{
+		// os CRCs que o convidado mandou antes de carregar o estado são da linha do tempo errada
+		g.crc_floor = std::max(g.crc_floor, guest_frame);
+		g.remote_crc.clear();
+		emit("\"event\":\"resynced\",\"frame\":%d", guest_frame);
+	}
+}
+
+// convidado: a transferência chegou inteira; carrega na fronteira de quadro
+void apply_transfer(running_machine &machine)
+{
+	transfer_in &x = g.xin;
+	if (!x.active || !x.complete)
+		return;
+	std::vector<uint8_t> state(x.raw_size);
+	uLongf size = x.raw_size;
+	bool ok = uncompress(state.data(), &size, x.packed.data(), x.packed_size) == Z_OK && size == x.raw_size && crc_of(state.data(), state.size()) == x.raw_crc;
+	if (!ok || !load_from(machine, state))
+	{
+		emit("\"event\":\"ended\",\"reason\":\"state_load_failed\"");
+		g.phase = phase_t::ENDED;
+		machine.schedule_exit();
+		return;
+	}
+
+	if (x.purpose == XFER_INITIAL)
+	{
+		g.delay = x.delay;
+		g.frame = x.frame;
+		// as primeiras entradas (antes do atraso) são neutras dos dois lados
+		g.local_last = g.frame + g.delay - 1;
+		for (int f = 0; f <= g.local_last; f++)
+			g.local[idx(f)] = 0;
+		g.phase = phase_t::RUNNING;
+		emit("\"event\":\"running\",\"delay\":%d,\"rtt\":%d", g.delay, int(g.rtt + 0.5f));
+	}
+	else
+	{
+		// ressincronia: o estado do anfitrião vale; refaz até o presente com as entradas que já temos
+		int const loaded = x.frame;
+		if (loaded >= g.frame)
+		{
+			g.frame = loaded;
+			g.local_last = std::max(g.local_last, g.frame + g.delay - 1);
+		}
+		else
+		{
+			int const target = g.frame;
+			g.frame = loaded;
+			for (int f = loaded; f < target; f++)
+				run_net_frame(machine, f, true, f + 1 < target);
+			g.frame = target;
+		}
+		g.local_crc.clear();
+		g.next_checksum = ((g.frame / CHECKSUM_INTERVAL) + 1) * CHECKSUM_INTERVAL;
+		g.crc_floor = g.frame;
+		emit("\"event\":\"resynced\",\"frame\":%d", loaded);
+	}
+	g.first_mispredicted = -1;
+
+	x.done_id = x.id;
+	x.active = false;
+	x.complete = false;
+	x.packed.clear();
+	x.have.clear();
+	for (int i = 0; i < 3; i++)
+	{
+		writer w(PKT_STATE_DONE, g.tag);
+		w.put16(x.done_id);
+		w.puti32(g.frame);
+		send_packet(w);
+	}
+}
+
+// anfitrião: manda o estado confirmado mais recente para o convidado carregar
+void start_resync(int reason_frame)
+{
+	uint32_t const now = net::now_ms();
+	if (g.xout.active || now - g.last_resync_ms < 2000)
+		return;
+	int frame = std::min(g.remote_last + 1, g.frame - 1);
+	if (frame < 0 || g.ring[frame % RING].frame != frame)
+	{
+		emit("\"event\":\"error\",\"reason\":\"resync_unavailable\",\"frame\":%d", reason_frame);
+		return;
+	}
+	if (begin_transfer(XFER_RESYNC, frame, g.ring[frame % RING].data))
+	{
+		g.last_resync_ms = now;
+		g.crc_floor = std::max(g.crc_floor, frame);
+	}
+}
+
+void poll(running_machine &machine)
+{
+	uint8_t buffer[2048];
+	net::endpoint from;
+	int got;
+	while ((got = net::receive(from, buffer, sizeof(buffer))) >= 0)
+	{
+		reader r(buffer, size_t(got));
+		if (r.get32() != MAGIC || r.get32() != g.tag)
+			continue;
+		uint8_t const type = r.get8();
+		if (!r.ok())
+			continue;
+		// depois de conectado, só o parceiro (ou ele com outra porta, se o NAT mudou: o HELLO segue)
+		if (g.peer_locked && from != g.peer && type != PKT_HELLO)
+			continue;
+		switch (type)
+		{
+		case PKT_HELLO: handle_hello(r, from); break;
+		case PKT_INPUT: if (g.heard_peer) handle_input(r); break;
+		case PKT_STATE_CHUNK: handle_state_chunk(r); break;
+		case PKT_STATE_ACK: handle_state_ack(r); break;
+		case PKT_STATE_DONE: handle_state_done(r); break;
+		case PKT_BYE:
+			if (g.heard_peer)
+				end_session("partner_left");
+			break;
+		default: break;
+		}
+		if (g.phase == phase_t::ENDED)
+			return;
+	}
+}
+
+
+//**************************************************************************
+//  PASSOS DO LAÇO
+//**************************************************************************
+
+void update_checksums()
+{
+	// estado confirmado: as entradas dos dois para todos os quadros antes dele já chegaram
+	while (g.next_checksum <= g.remote_last + 1 && g.next_checksum <= g.frame - 1)
+	{
+		int const f = g.next_checksum;
+		g.next_checksum += CHECKSUM_INTERVAL;
+		state_slot &slot = g.ring[f % RING];
+		if (slot.frame != f || f < g.crc_floor)
+			continue;
+		g.local_crc[f] = state_crc(slot.data);
+		while (g.local_crc.size() > 64)
+			g.local_crc.erase(g.local_crc.begin());
+		compare_crc(f);
+	}
+}
+
+void report_stats()
+{
+	uint32_t const now = net::now_ms();
+	if (now - g.last_stats_ms < STATS_INTERVAL_MS)
+		return;
+	g.last_stats_ms = now;
+	emit("\"event\":\"stats\",\"frame\":%d,\"rtt\":%d,\"delay\":%d,\"rollbacks\":%d,\"resimulated\":%d,\"max_rollback\":%d,\"stall_ms\":%d,\"desyncs\":%d,\"ahead\":%.2f",
+			g.frame, int(g.rtt + 0.5f), g.delay, g.rollbacks, g.resimulated, g.max_rollback, g.stalls, g.desyncs, (g.remote_adv - g.local_adv) / 2.0f);
+}
+
+void check_timeouts()
+{
+	uint32_t const now = net::now_ms();
+	if (g.phase == phase_t::CONNECTING)
+	{
+		if (now - g.started_ms > CONNECT_TIMEOUT_MS)
+			end_session("connect_failed");
+		return;
+	}
+	uint32_t const silent = now - g.last_recv_ms;
+	if (silent > DISCONNECT_MS)
+		end_session("timeout");
+	else if (silent > UNSTABLE_MS && !g.unstable_reported)
+	{
+		g.unstable_reported = true;
+		emit("\"event\":\"unstable\",\"silent_ms\":%u", silent);
+	}
+}
+
+int auto_delay()
+{
+	// rollback cobre até ~4 quadros de ida; acima disso um pouco de atraso evita voltas longas
+	double const one_way = (g.rtt_known ? g.rtt : 60.0f) / 2.0 / g.frame_ms;
+	int const delay = int(one_way + 0.999) - 4;
+	return std::clamp(delay, 0, 4);
+}
+
+void net_connecting(running_machine &machine)
+{
+	uint32_t const now = net::now_ms();
+	if (now - g.last_hello_ms >= HELLO_INTERVAL_MS)
+		send_hello();
+
+	if (g.heard_peer && g.peer_heard_us)
+	{
+		emit("\"event\":\"connected\",\"peer\":\"%s\",\"rtt\":%d", net::to_string(g.peer).c_str(), int(g.rtt + 0.5f));
+		if (g.slot == 0)
+		{
+			// mais uns HELLOs medem melhor o ping antes de escolher o atraso
+			for (int i = 0; i < 4; i++)
+			{
+				send_hello();
+				for (int j = 0; j < 30 && g.phase == phase_t::CONNECTING; j++)
+				{
+					net::sleep_us(1000);
+					poll(machine);
+				}
+			}
+			int const option = machine.options().int_value(OPT_DELAY);
+			g.delay = option >= 0 ? std::min(option, 8) : auto_delay();
+			if (!save_into(machine, g.scratch) || !begin_transfer(XFER_INITIAL, 0, g.scratch))
+			{
+				emit("\"event\":\"ended\",\"reason\":\"state_save_failed\"");
+				g.phase = phase_t::ENDED;
+				machine.schedule_exit();
+				return;
+			}
+			g.local_last = g.delay - 1;
+			for (int f = 0; f <= g.local_last; f++)
+				g.local[idx(f)] = 0;
+			g.phase = phase_t::SYNC_SEND;
+		}
+		else
+		{
+			g.phase = phase_t::SYNC_RECV;
+		}
+		return;
+	}
+	idle_wait();
+	pump_window();
+}
+
+void net_running(running_machine &machine)
+{
+	if (g.slot == 1)
+	{
+		apply_transfer(machine);
+		if (g.xin.active && net::now_ms() - g.xin.last_ack_ms >= 30)
+			send_state_ack();
+	}
+	pump_transfer();
+
+	if (g.first_mispredicted >= 0)
+	{
+		int const from = g.first_mispredicted;
+		g.first_mispredicted = -1;
+		rollback(machine, from);
+	}
+	update_checksums();
+
+	// janela de previsão cheia: espera a entrada do parceiro
+	if (g.frame - (g.remote_last + 1) >= MAX_PREDICTION)
+	{
+		g.stalls++;
+		if (net::now_ms() - g.last_input_send_ms >= 5)
+			send_input();
+		forgive_wait(1000);
+		pump_window();
+		return;
+	}
+
+	// sincronia de tempo: quem está na frente desacelera um pouco a cada quadro
+	uint32_t const now = net::now_ms();
+	if (g.remote_frame >= 0)
+	{
+		double const remote_now = g.remote_frame + (double(now - g.remote_frame_ms) + g.rtt / 2.0) / g.frame_ms;
+		g.local_adv = g.local_adv * 0.9f + float(remote_now - g.frame) * 0.1f;
+	}
+	float const ahead = (g.remote_adv - g.local_adv) / 2.0f;
+	if (ahead > 0.6f)
+		forgive_wait(int64_t(std::min(ahead, 3.0f) * 1500.0f));
+
+	// controle local para o quadro + atraso
+	uint16_t const in = g.autoinput ? auto_input(g.frame + g.delay, g.slot) : sample_local(machine);
+	while (g.local_last < g.frame + g.delay)
+	{
+		g.local_last++;
+		g.local[idx(g.local_last)] = in;
+	}
+	send_input();
+
+	run_net_frame(machine, g.frame, false, false);
+	g.frame++;
+	report_stats();
+}
+
+void net_iteration(running_machine &machine)
+{
+	poll(machine);
+	if (g.phase == phase_t::ENDED)
+	{
+		pump_window();
+		idle_wait();
+		return;
+	}
+	check_timeouts();
+	if (g.phase == phase_t::ENDED)
+		return;
+
+	switch (g.phase)
+	{
+	case phase_t::CONNECTING:
+		net_connecting(machine);
+		break;
+
+	case phase_t::SYNC_SEND:
+		pump_transfer();
+		if (net::now_ms() - g.last_input_send_ms >= 50)
+		{
+			send_hello();
+			g.last_input_send_ms = net::now_ms();
+		}
+		idle_wait();
+		pump_window();
+		break;
+
+	case phase_t::SYNC_RECV:
+		if (g.xin.active && g.xin.complete)
+		{
+			apply_transfer(machine);
+		}
+		else
+		{
+			if (g.xin.active && net::now_ms() - g.xin.last_ack_ms >= 30)
+				send_state_ack();
+			if (!g.xin.active && net::now_ms() - g.last_hello_ms >= HELLO_INTERVAL_MS)
+				send_hello();
+			idle_wait();
+			pump_window();
+		}
+		break;
+
+	case phase_t::RUNNING:
+		net_running(machine);
+		break;
+
+	default:
+		break;
+	}
+}
+
+
+//**************************************************************************
+//  SYNCTEST
+//**************************************************************************
+
+void synctest_fail(running_machine &machine, int frame, const std::vector<uint8_t> &redone, const std::vector<uint8_t> &original)
+{
+	std::string const detail = describe_difference(machine, redone, original);
+	emit("\"event\":\"synctest\",\"result\":\"fail\",\"game\":\"%s\",\"frame\":%d,\"checked\":%d,\"items\":\"%s\"",
+			machine.system().name, frame, g.synctest_checked, detail.c_str());
+	g.synctest_failed = true;
+	machine.schedule_exit();
+}
+
+void synctest_iteration(running_machine &machine)
+{
+	if (g.synctest_failed)
+	{
+		emulate_frame(machine, false, false);
+		return;
+	}
+	if (g.frame == 0)
+	{
+		save_slot(machine, 0);
+		g.synctest_crc[0] = state_crc(g.ring[0].data);
+	}
+
+	int const f = g.frame;
+	uint16_t const p1 = auto_input(f, 0);
+	uint16_t const p2 = auto_input(f, 1);
+	g.synctest_inputs[0][idx(f)] = p1;
+	g.synctest_inputs[1][idx(f)] = p2;
+	latch(machine, p1, p2);
+	emulate_frame(machine, false, false);
+	g.frame++;
+
+	// estado no começo do quadro seguinte, o original
+	save_slot(machine, g.frame);
+	state_slot &original = g.ring[g.frame % RING];
+	g.synctest_crc[idx(g.frame)] = state_crc(original.data);
+
+	if (g.frame <= g.synctest_depth)
+		return;
+
+	// volta de 1 a N quadros e refaz
+	g.synctest_rng = g.synctest_rng * 1664525u + 1013904223u;
+	int const depth = 1 + int((g.synctest_rng >> 16) % uint32_t(g.synctest_depth));
+	int const back = g.frame - depth;
+	if (!load_slot(machine, back))
+	{
+		emit("\"event\":\"synctest\",\"result\":\"fail\",\"game\":\"%s\",\"frame\":%d,\"items\":\"load_failed\"", machine.system().name, back);
+		g.synctest_failed = true;
+		machine.schedule_exit();
+		return;
+	}
+	for (int rf = back; rf < g.frame; rf++)
+	{
+		latch(machine, g.synctest_inputs[0][idx(rf)], g.synctest_inputs[1][idx(rf)]);
+		emulate_frame(machine, true, rf + 1 < g.frame);
+		if (!save_into(machine, g.scratch))
+			continue;
+		g.synctest_checked++;
+		if (state_crc(g.scratch) != g.synctest_crc[idx(rf + 1)])
+		{
+			state_slot &want = g.ring[(rf + 1) % RING];
+			synctest_fail(machine, rf + 1, g.scratch, want.frame == rf + 1 ? want.data : g.scratch);
+			return;
+		}
+	}
+	g.resimulated += depth;
+	g.rollbacks++;
+
+	uint32_t const now = net::now_ms();
+	if (now - g.last_stats_ms >= STATS_INTERVAL_MS)
+	{
+		g.last_stats_ms = now;
+		emit("\"event\":\"synctest_progress\",\"frame\":%d,\"checked\":%d", g.frame, g.synctest_checked);
+	}
+}
+
+} // anonymous namespace
+
+
+//**************************************************************************
+//  INTERFACE
+//**************************************************************************
+
+bool configured(const emu_options &options)
+{
+	const char *netplay = options.value(OPT_NETPLAY);
+	return (netplay && *netplay) || options.int_value(OPT_SYNCTEST) > 0;
+}
+
+
+void apply_options(emu_options &options)
+{
+	if (!configured(options))
+		return;
+	static const std::pair<const char *, const char *> s_locked[] =
+	{
+		// a mesma velocidade dos dois lados, sem pular quadros
+		{ OPTION_THROTTLE,           "1" },
+		{ OPTION_SPEED,              "1.0" },
+		{ OPTION_REFRESHSPEED,       "0" },
+		{ OPTION_FRAMESKIP,          "0" },
+		{ OPTION_AUTOFRAMESKIP,      "0" },
+		// estados salvos de fora desfariam a dupla
+		{ OPTION_STATE,              "" },
+		{ OPTION_AUTOSAVE,           "0" },
+		{ OPTION_REWIND,             "0" },
+		// a placa igual nos dois: BIOS padrão e NVRAM nova (o convidado ainda recebe o estado do anfitrião)
+		{ OPTION_BIOS,               "" },
+		{ OPTION_NVRAM_SAVE,         "0" },
+		{ OPTION_CHEAT,              "0" },
+		{ OPTION_DEBUG,              "0" },
+		{ OPTION_CONSOLE,            "0" },
+		{ OPTION_AUTOBOOT_SCRIPT,    "" },
+		{ OPTION_AUTOBOOT_COMMAND,   "" },
+		{ OPTION_HTTP,               "0" },
+	};
+	for (auto const &[name, value] : s_locked)
+		options.set_value(name, value, OPTION_PRIORITY_MAXIMUM);
+	if (options.int_value(OPT_SYNCTEST) > 0)
+		options.set_value(OPTION_THROTTLE, "0", OPTION_PRIORITY_MAXIMUM);
+}
+
+
+void start(running_machine &machine)
+{
+	g = session();
+	g.machine = &machine;
+	g_resimulating = false;
+	g_frame_done = false;
+	g_forgiven_ticks = 0;
+
+	const emu_options &options = machine.options();
+	std::string const netplay = options.value(OPT_NETPLAY) ? options.value(OPT_NETPLAY) : "";
+	int const synctest = options.int_value(OPT_SYNCTEST);
+	if (netplay.empty() && synctest <= 0)
+		return;
+
+	screen_device *screen = screen_device_enumerator(machine.root_device()).first();
+	if (!screen)
+	{
+		emit("\"event\":\"ended\",\"reason\":\"no_screen\"");
+		machine.schedule_exit();
+		return;
+	}
+	g.frame_ms = screen->frame_period().as_double() * 1000.0;
+	if (g.frame_ms <= 1.0 || g.frame_ms > 100.0)
+		g.frame_ms = 1000.0 / 60.0;
+
+	if (!machine.save().supported())
+	{
+		emit("\"event\":\"ended\",\"reason\":\"no_save_state\",\"game\":\"%s\"", machine.system().name);
+		machine.schedule_exit();
+		return;
+	}
+
+	build_fieldmap(machine);
+	g.state_size = compute_state_size(machine);
+	find_ignored_ranges(machine);
+	g.local.assign(HISTORY, 0);
+	g.remote.assign(HISTORY, 0);
+	g.used_remote.assign(HISTORY, 0);
+	g.last_stats_ms = net::now_ms();
+
+	if (synctest > 0)
+	{
+		g.mode = run_mode::SYNCTEST;
+		g.synctest_depth = std::clamp(synctest, 1, RING - 2);
+		g.synctest_crc.assign(HISTORY, 0);
+		g.synctest_inputs[0].assign(HISTORY, 0);
+		g.synctest_inputs[1].assign(HISTORY, 0);
+		emit("\"event\":\"synctest_start\",\"game\":\"%s\",\"depth\":%d,\"state_bytes\":%u,\"frame_ms\":%.3f",
+				machine.system().name, g.synctest_depth, unsigned(g.state_size), g.frame_ms);
+		return;
+	}
+
+	if (netplay != "host" && netplay != "guest")
+	{
+		emit("\"event\":\"ended\",\"reason\":\"bad_mode\"");
+		machine.schedule_exit();
+		return;
+	}
+	g.slot = (netplay == "host") ? 0 : 1;
+	g.autoinput = options.bool_value(OPT_AUTOINPUT);
+
+	std::string const key = options.value(OPT_KEY) ? options.value(OPT_KEY) : "";
+	g.tag = crc_of_string("shmupx-netplay:" + key);
+	g.version = crc_of_string(std::string("shmupx-netplay/") + std::to_string(PROTOCOL) + "/" + __DATE__ + " " + __TIME__);
+
+	// ROMs: os dois têm que ter exatamente os mesmos dados
+	{
+		std::vector<std::pair<std::string, memory_region *>> regions;
+		for (auto &region : machine.memory().regions())
+			regions.emplace_back(region.first, region.second.get());
+		std::sort(regions.begin(), regions.end(), [] (auto const &a, auto const &b) { return a.first < b.first; });
+		uLong crc = crc32(0L, Z_NULL, 0);
+		for (auto const &[name, region] : regions)
+		{
+			crc = crc32(crc, reinterpret_cast<const Bytef *>(name.data()), uInt(name.size()));
+			if (region->base() && region->bytes())
+			{
+				uint32_t const region_crc = crc_of(region->base(), region->bytes());
+				crc = crc32(crc, reinterpret_cast<const Bytef *>(&region_crc), sizeof(region_crc));
+			}
+		}
+		g.romhash = uint32_t(crc);
+	}
+
+	{
+		std::string const simulate = options.value(OPT_SIMULATE) ? options.value(OPT_SIMULATE) : "";
+		int delay = 0, jitter = 0, loss = 0;
+		if (!simulate.empty() && std::sscanf(simulate.c_str(), "%d,%d,%d", &delay, &jitter, &loss) >= 1)
+			net::simulate(delay, jitter, loss);
+	}
+
+	std::string error;
+	int const port = options.int_value(OPT_PORT);
+	if (!net::open(uint16_t(std::clamp(port, 0, 65535)), error))
+	{
+		emit("\"event\":\"ended\",\"reason\":\"socket\",\"detail\":\"%s\"", error.c_str());
+		machine.schedule_exit();
+		return;
+	}
+	g.candidates = net::parse_list(options.value(OPT_PEER) ? options.value(OPT_PEER) : "");
+	if (g.candidates.empty() && g.slot == 1)
+	{
+		emit("\"event\":\"ended\",\"reason\":\"no_peer\"");
+		machine.schedule_exit();
+		return;
+	}
+
+	g.mode = run_mode::NET;
+	g.phase = phase_t::CONNECTING;
+	g.started_ms = net::now_ms();
+	g.last_recv_ms = g.started_ms;
+	emit("\"event\":\"connecting\",\"slot\":%d,\"port\":%u,\"candidates\":%d,\"state_bytes\":%u,\"game\":\"%s\"",
+			g.slot, net::local_port(), int(g.candidates.size()), unsigned(g.state_size), machine.system().name);
+}
+
+
+void stop(running_machine &machine)
+{
+	if (g.mode == run_mode::NET)
+	{
+		if (g.heard_peer && g.phase != phase_t::ENDED)
+		{
+			for (int i = 0; i < 3; i++)
+			{
+				writer w(PKT_BYE, g.tag);
+				send_packet(w);
+			}
+			emit("\"event\":\"ended\",\"reason\":\"local_exit\",\"frame\":%d", g.frame);
+		}
+		emit("\"event\":\"summary\",\"frames\":%d,\"rollbacks\":%d,\"resimulated\":%d,\"max_rollback\":%d,\"stalls\":%d,\"desyncs\":%d,\"rtt\":%d",
+				g.frame, g.rollbacks, g.resimulated, g.max_rollback, g.stalls, g.desyncs, int(g.rtt + 0.5f));
+		net::close();
+	}
+	else if (g.mode == run_mode::SYNCTEST && !g.synctest_failed)
+	{
+		emit("\"event\":\"synctest\",\"result\":\"%s\",\"game\":\"%s\",\"frames\":%d,\"checked\":%d,\"rollbacks\":%d,\"state_bytes\":%u",
+				g.synctest_checked > 0 ? "ok" : "empty", machine.system().name, g.frame, g.synctest_checked, g.rollbacks, unsigned(g.state_size));
+	}
+	g.mode = run_mode::NONE;
+}
+
+
+bool active()
+{
+	return g.mode != run_mode::NONE;
+}
+
+
+void run_iteration(running_machine &machine)
+{
+	if (g.mode == run_mode::SYNCTEST)
+		synctest_iteration(machine);
+	else if (g.mode == run_mode::NET)
+		net_iteration(machine);
+}
+
+
+bool resimulating()
+{
+	return g_resimulating;
+}
+
+
+bool next_frame_resimulated()
+{
+	return g_next_resimulated;
+}
+
+
+void frame_done()
+{
+	g_frame_done = true;
+}
+
+
+int64_t take_forgiven_ticks()
+{
+	int64_t const ticks = g_forgiven_ticks;
+	g_forgiven_ticks = 0;
+	return ticks;
+}
+
+
+bool field_state(const ioport_field &field, bool &state)
+{
+	if (g.mode == run_mode::NONE)
+		return false;
+	auto const found = g.fieldmap.find(&field);
+	if (found == g.fieldmap.end() || found->second == 0xffff)
+	{
+		state = false;
+		return true;
+	}
+	int const slot = found->second >> 8;
+	int const bit = found->second & 0xff;
+	state = (g.current[slot] >> bit) & 1;
+	return true;
+}
+
+} // namespace shmupx_netplay
