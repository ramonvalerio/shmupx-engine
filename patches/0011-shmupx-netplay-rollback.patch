diff --git a/src/emu/shmupx_netplay.cpp b/src/emu/shmupx_netplay.cpp
new file mode 100644
index 0000000..5e7738e
--- /dev/null
+++ b/src/emu/shmupx_netplay.cpp
@@ -0,0 +1,1779 @@
+// license:GPL-2.0-or-later
+// copyright-holders:ShmupX
+/***************************************************************************
+
+    shmupx_netplay.cpp
+
+    ShmupX Engine: dupla online com rollback e o SyncTest.
+
+    Quadro f, na fronteira (logo depois do VBLANK do quadro f-1, com todas
+    as CPUs no mesmo instante):
+
+      1. guarda o estado da máquina no anel (estado no começo de f);
+      2. trava nas portas as entradas de f dos dois jogadores (as do
+         parceiro que ainda não chegaram são previstas: a última que chegou);
+      3. emula até o VBLANK de f (o jogo lê as portas durante f).
+
+    Quando a entrada real do parceiro chega e difere da prevista no quadro
+    m, a máquina volta ao estado de m e refaz m..f-1 sem desenhar, sem som e
+    sem esperar. A entrada local é lida no mesmo ponto em que o motor offline
+    a lê (osd input_update no fim do quadro anterior): o controle local tem o
+    atraso do jogo offline, mais o atraso de rede escolhido (0 em conexões
+    boas).
+
+    A cada 30 quadros confirmados os dois comparam o CRC do estado. Se
+    divergir (desync), o anfitrião manda o estado dele e o convidado o
+    carrega e refaz os quadros até o presente. O começo da partida usa o
+    mesmo envio: o convidado começa do estado do anfitrião (NVRAM, relógio,
+    tudo igual).
+
+    SyncTest (-shmupx_synctest N): sem rede, a cada quadro volta de 1 a N
+    quadros e refaz com as mesmas entradas, comparando o CRC de cada estado
+    refeito com o original. Um jogo só entra no treino em dupla depois de
+    passar nele.
+
+***************************************************************************/
+
+#include "emu.h"
+#include "shmupx_netplay.h"
+#include "shmupx_netplay_net.h"
+
+#include "emuopts.h"
+#include "input.h"
+#include "screen.h"
+
+#include "osdepend.h"
+
+#include <zlib.h>
+
+#include <algorithm>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace shmupx_netplay {
+
+namespace {
+
+//**************************************************************************
+//  CONSTANTES
+//**************************************************************************
+
+#define OPT_NETPLAY        "shmupx_netplay"
+#define OPT_PORT           "shmupx_netplay_port"
+#define OPT_PEER           "shmupx_netplay_peer"
+#define OPT_KEY            "shmupx_netplay_key"
+#define OPT_DELAY          "shmupx_netplay_delay"
+#define OPT_AUTOINPUT      "shmupx_netplay_autoinput"
+#define OPT_SIMULATE       "shmupx_netplay_simulate"
+#define OPT_SYNCTEST       "shmupx_synctest"
+
+constexpr uint32_t MAGIC = 0x53584e31;          // "SXN1"
+constexpr uint32_t PROTOCOL = 1;
+constexpr int MAX_PREDICTION = 8;               // quadros que dá para prever sem a entrada do parceiro
+constexpr int RING = 16;                        // estados guardados (> MAX_PREDICTION + folga)
+constexpr int HISTORY = 1 << 14;                // entradas guardadas (~4,5 min)
+constexpr int CHECKSUM_INTERVAL = 30;
+constexpr int CHUNK_BYTES = 1000;
+constexpr int MAX_INPUTS_PER_PACKET = 64;
+constexpr uint32_t HELLO_INTERVAL_MS = 100;
+constexpr uint32_t CONNECT_TIMEOUT_MS = 45000;
+constexpr uint32_t UNSTABLE_MS = 2500;
+constexpr uint32_t DISCONNECT_MS = 15000;
+constexpr uint32_t STATS_INTERVAL_MS = 5000;
+
+// bits da entrada de um jogador
+enum : uint16_t
+{
+	BIT_UP = 1 << 0, BIT_DOWN = 1 << 1, BIT_LEFT = 1 << 2, BIT_RIGHT = 1 << 3,
+	BIT_BUTTON1 = 1 << 4,   // ... BUTTON8 = 1 << 11
+	BIT_START = 1 << 12,
+	BIT_COIN = 1 << 13
+};
+
+enum packet_type : uint8_t
+{
+	PKT_HELLO = 1,
+	PKT_INPUT = 2,
+	PKT_STATE_CHUNK = 3,
+	PKT_STATE_ACK = 4,
+	PKT_STATE_DONE = 5,
+	PKT_BYE = 6
+};
+
+enum class run_mode { NONE, SYNCTEST, NET };
+enum class phase_t { CONNECTING, SYNC_SEND, SYNC_RECV, RUNNING, ENDED };
+enum xfer_purpose : uint8_t { XFER_INITIAL = 1, XFER_RESYNC = 2 };
+
+
+//**************************************************************************
+//  PACOTES (little-endian)
+//**************************************************************************
+
+class writer
+{
+public:
+	writer(uint8_t type, uint32_t tag) { put32(MAGIC); put32(tag); put8(type); }
+	void put8(uint8_t v) { m_data.push_back(v); }
+	void put16(uint16_t v) { put8(v & 0xff); put8(v >> 8); }
+	void put32(uint32_t v) { put16(v & 0xffff); put16(v >> 16); }
+	void puti32(int32_t v) { put32(uint32_t(v)); }
+	void puti16(int16_t v) { put16(uint16_t(v)); }
+	void put(const void *p, size_t n) { m_data.insert(m_data.end(), (const uint8_t *)p, (const uint8_t *)p + n); }
+	const uint8_t *data() const { return m_data.data(); }
+	size_t size() const { return m_data.size(); }
+private:
+	std::vector<uint8_t> m_data;
+};
+
+class reader
+{
+public:
+	reader(const uint8_t *p, size_t n) : m_p(p), m_end(p + n) { }
+	bool ok() const { return m_ok; }
+	uint8_t get8() { if (m_p >= m_end) { m_ok = false; return 0; } return *m_p++; }
+	uint16_t get16() { uint16_t lo = get8(); return lo | (uint16_t(get8()) << 8); }
+	uint32_t get32() { uint32_t lo = get16(); return lo | (uint32_t(get16()) << 16); }
+	int32_t geti32() { return int32_t(get32()); }
+	int16_t geti16() { return int16_t(get16()); }
+	const uint8_t *take(size_t n) { if (size_t(m_end - m_p) < n) { m_ok = false; return nullptr; } const uint8_t *r = m_p; m_p += n; return r; }
+	size_t left() const { return size_t(m_end - m_p); }
+private:
+	const uint8_t *m_p;
+	const uint8_t *m_end;
+	bool m_ok = true;
+};
+
+
+//**************************************************************************
+//  ESTADO DA SESSÃO
+//**************************************************************************
+
+struct field_live_copy { uint8_t impulse; bool last; };
+
+struct state_slot
+{
+	int frame = -1;
+	std::vector<uint8_t> data;
+	std::vector<field_live_copy> fields;
+};
+
+struct transfer_out
+{
+	bool active = false;
+	uint16_t id = 0;
+	uint8_t purpose = 0;
+	int frame = 0;
+	uint32_t raw_size = 0;
+	uint32_t raw_crc = 0;
+	std::vector<uint8_t> packed;
+	int count = 0;
+	int next = 0;                   // primeira passada
+	std::vector<uint16_t> resend;   // pedidos pelo convidado
+	uint32_t last_send_ms = 0;
+	uint32_t started_ms = 0;
+};
+
+struct transfer_in
+{
+	bool active = false;
+	bool complete = false;
+	uint16_t id = 0;
+	uint8_t purpose = 0;
+	int frame = 0;
+	int delay = 0;
+	uint32_t raw_size = 0;
+	uint32_t raw_crc = 0;
+	uint32_t packed_size = 0;
+	int count = 0;
+	int received = 0;
+	std::vector<uint8_t> packed;
+	std::vector<bool> have;
+	uint32_t last_ack_ms = 0;
+	uint16_t done_id = 0xffff;      // última transferência já aplicada (para repetir o DONE)
+};
+
+struct session
+{
+	running_machine *machine = nullptr;
+	run_mode mode = run_mode::NONE;
+	phase_t phase = phase_t::CONNECTING;
+	int slot = 0;                   // 0 = anfitrião (jogador 1), 1 = convidado (jogador 2)
+	bool autoinput = false;
+
+	// campos de controle
+	std::unordered_map<const ioport_field *, uint16_t> fieldmap;   // (slot << 8) | bit; 0xffff = neutro
+	std::vector<std::pair<const ioport_field *, uint16_t>> local_fields;  // campos do jogador 1 local -> bit
+	std::vector<const ioport_field *> all_fields;
+	std::vector<digital_joystick *> joysticks;
+	uint16_t current[2] = { 0, 0 };
+
+	// quadros e entradas
+	int frame = 0;
+	int delay = 0;
+	std::vector<uint16_t> local, remote, used_remote;
+	int local_last = -1;            // última entrada local gerada
+	int remote_last = -1;           // última entrada do parceiro recebida (contígua)
+	int peer_ack = -1;              // última entrada local que o parceiro confirmou
+	int first_mispredicted = -1;
+
+	// estados
+	size_t state_size = 0;
+	state_slot ring[RING];
+	std::vector<uint8_t> scratch;
+
+	// rede
+	std::vector<net::endpoint> candidates;
+	net::endpoint peer;
+	bool peer_locked = false;
+	bool heard_peer = false;
+	bool peer_heard_us = false;
+	uint32_t tag = 0;
+	uint32_t version = 0;
+	uint32_t romhash = 0;
+	uint32_t started_ms = 0;
+	uint32_t last_recv_ms = 0;
+	uint32_t last_hello_ms = 0;
+	uint32_t last_input_send_ms = 0;
+	uint32_t last_pump_ms = 0;
+	bool unstable_reported = false;
+	float rtt = 0.0f;               // ms, suavizado
+	bool rtt_known = false;
+	uint32_t echo_ts = 0;           // último ts do parceiro
+	uint32_t echo_recv_ms = 0;
+
+	// sincronia de tempo
+	double frame_ms = 1000.0 / 60.0;
+	int remote_frame = -1;
+	uint32_t remote_frame_ms = 0;
+	float local_adv = 0.0f;
+	float remote_adv = 0.0f;
+
+	// checagem de estado
+	std::map<int, uint32_t> local_crc;
+	std::map<int, uint32_t> remote_crc;
+	int next_checksum = CHECKSUM_INTERVAL;
+	int crc_floor = 0;              // CRCs de quadros antes disto são ignorados (depois de uma ressincronia)
+	int last_checked_crc = -1;      // cada quadro de CRC é comparado uma vez só
+	uint32_t last_resync_ms = 0;
+
+	transfer_out xout;
+	transfer_in xin;
+	uint16_t next_xfer_id = 1;
+
+	// estatística
+	int rollbacks = 0;
+	int resimulated = 0;
+	int max_rollback = 0;
+	int stalls = 0;
+	int desyncs = 0;
+	uint32_t last_stats_ms = 0;
+
+	// SyncTest
+	int synctest_depth = 0;
+	std::vector<uint32_t> synctest_crc;
+	std::vector<uint16_t> synctest_inputs[2];
+	uint32_t synctest_rng = 0x2545f491;
+	bool synctest_failed = false;
+	int synctest_checked = 0;
+};
+
+session g;
+bool g_resimulating = false;
+bool g_next_resimulated = false;
+bool g_frame_done = false;
+int64_t g_forgiven_ticks = 0;
+
+
+//**************************************************************************
+//  SAÍDA PARA O CLIENT
+//**************************************************************************
+
+void emit(const char *format, ...)
+{
+	char body[1024];
+	va_list args;
+	va_start(args, format);
+	std::vsnprintf(body, sizeof(body), format, args);
+	va_end(args);
+	std::fprintf(stdout, "SHMUPX_NETPLAY {%s}\n", body);
+	std::fflush(stdout);
+}
