+// license:GPL-2.0-or-later
+// copyright-holders:ShmupX
+/***************************************************************************
+
+    shmupx_netplay.h
+
+    ShmupX Engine: dupla online com rollback (treino em dupla) e o teste de
+    determinismo (SyncTest) que certifica cada jogo.
+
+    O laço principal da máquina passa a ser da dupla: a cada quadro ela lê o
+    controle local, troca as entradas com o parceiro, prevê as que ainda não
+    chegaram e, quando uma previsão erra, volta ao estado salvo daquele
+    quadro e refaz os quadros seguintes sem vídeo nem som.
+
+***************************************************************************/
+
+#ifndef MAME_EMU_SHMUPX_NETPLAY_H
+#define MAME_EMU_SHMUPX_NETPLAY_H
+
+#pragma once
+
+#include <cstdint>
+
+class running_machine;
+class emu_options;
+class ioport_field;
+
+namespace shmupx_netplay {
+
+// -shmupx_netplay host|guest ou -shmupx_synctest N na linha de comando
+bool configured(const emu_options &options);
+// travas da dupla, com prioridade máxima (como o ranked, sem o estado inicial)
+void apply_options(emu_options &options);
+
+// começo e fim do laço principal da máquina
+void start(running_machine &machine);
+void stop(running_machine &machine);
+
+// a dupla (ou o SyncTest) comanda o laço principal
+bool active();
+// um passo do laço principal no lugar do timeslice: um quadro, uma espera ou um rollback
+void run_iteration(running_machine &machine);
+
+// o quadro em execução está sendo refeito pelo rollback: sem vídeo, som, espera nem plugins
+bool resimulating();
+// o próximo quadro também será refeito (o vídeo não desenha nele)
+bool next_frame_resimulated();
+// fim do quadro (video_manager::frame_update)
+void frame_done();
+// tempo esperado de propósito pela sincronia (ticks do OSD) que o throttle não deve compensar
+int64_t take_forgiven_ticks();
+
+// os controles dos dois jogadores vêm da dupla: true = a dupla decide o campo (estado em state)
+bool field_state(const ioport_field &field, bool &state);
+
+} // namespace shmupx_netplay
+
+#endif // MAME_EMU_SHMUPX_NETPLAY_H
diff --git a/src/emu/shmupx_netplay_net.cpp b/src/emu/shmupx_netplay_net.cpp
new file mode 100644
index 0000000..36e7743
--- /dev/null
+++ b/src/emu/shmupx_netplay_net.cpp
@@ -0,0 +1,330 @@
+// license:GPL-2.0-or-later
+// copyright-holders:ShmupX
+/***************************************************************************
+
+    shmupx_netplay_net.cpp
+
+    ShmupX Engine: socket UDP da dupla online (Winsock no Windows, BSD nos
+    outros), com simulação de atraso e perda para os testes.
+
+***************************************************************************/
+
+#include "shmupx_netplay_net.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <random>
+#include <thread>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+typedef SOCKET socket_t;
+static const socket_t BAD_SOCKET = INVALID_SOCKET;
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+typedef int socket_t;
+static const socket_t BAD_SOCKET = -1;
+#endif
+
+namespace shmupx_netplay::net {
+
+namespace {
+
+socket_t g_socket = BAD_SOCKET;
+uint16_t g_port = 0;
+#ifdef _WIN32
+bool g_wsa = false;
+#endif
+
+// simulação (testes): pacotes guardados até a hora de sair
+struct delayed_packet
+{
+	uint32_t due;
+	endpoint to;
+	std::vector<uint8_t> data;
+};
+int g_sim_delay = 0;
+int g_sim_jitter = 0;
+int g_sim_loss = 0;
+std::deque<delayed_packet> g_delayed;
+std::mt19937 g_rng(12345);
+
+const auto g_clock_start = std::chrono::steady_clock::now();
+
+sockaddr_in to_sockaddr(const endpoint &ep)
+{
+	sockaddr_in addr;
+	std::memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_addr.s_addr = htonl(ep.ip);
+	addr.sin_port = htons(ep.port);
+	return addr;
+}
+
+bool raw_send(const endpoint &to, const void *data, size_t size)
+{
+	if (g_socket == BAD_SOCKET || !to.valid())
+		return false;
+	sockaddr_in addr = to_sockaddr(to);
+	int const sent = ::sendto(g_socket, reinterpret_cast<const char *>(data), int(size), 0, reinterpret_cast<sockaddr *>(&addr), sizeof(addr));
+	return sent == int(size);
+}
+
+void flush_delayed()
+{
+	uint32_t const now = now_ms();
+	while (!g_delayed.empty() && int32_t(now - g_delayed.front().due) >= 0)
+	{
+		raw_send(g_delayed.front().to, g_delayed.front().data.data(), g_delayed.front().data.size());
+		g_delayed.pop_front();
+	}
+}
+
+} // anonymous namespace
+
+
+bool open(uint16_t port, std::string &error)
+{
+	close();
+#ifdef _WIN32
+	if (!g_wsa)
+	{
+		WSADATA wsa;
+		if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0)
+		{
+			error = "WSAStartup falhou";
+			return false;
+		}
+		g_wsa = true;
+	}
+#endif
+	g_socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (g_socket == BAD_SOCKET)
+	{
+		error = "não foi possível criar o socket UDP";
+		return false;
+	}
+
+	// buffers grandes: a transferência do estado manda muitos pacotes de uma vez
+	int bufsize = 4 * 1024 * 1024;
+	::setsockopt(g_socket, SOL_SOCKET, SO_RCVBUF, reinterpret_cast<const char *>(&bufsize), sizeof(bufsize));
+	::setsockopt(g_socket, SOL_SOCKET, SO_SNDBUF, reinterpret_cast<const char *>(&bufsize), sizeof(bufsize));
+
+#ifdef _WIN32
+	// sem isso, um ICMP "porta inalcançável" (o parceiro ainda abrindo) derruba o recvfrom com WSAECONNRESET
+	BOOL report = FALSE;
+	DWORD returned = 0;
+	WSAIoctl(g_socket, _WSAIOW(IOC_VENDOR, 12), &report, sizeof(report), nullptr, 0, &returned, nullptr, nullptr);
+#endif
+
+	sockaddr_in addr;
+	std::memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_addr.s_addr = htonl(INADDR_ANY);
+	addr.sin_port = htons(port);
+	if (::bind(g_socket, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) != 0)
+	{
+		error = "a porta UDP " + std::to_string(port) + " está em uso";
+		close();
+		return false;
+	}
+
+#ifdef _WIN32
+	u_long nonblocking = 1;
+	ioctlsocket(g_socket, FIONBIO, &nonblocking);
+#else
+	fcntl(g_socket, F_SETFL, fcntl(g_socket, F_GETFL, 0) | O_NONBLOCK);
+#endif
+
+	sockaddr_in bound;
+	socklen_t len = sizeof(bound);
+	if (::getsockname(g_socket, reinterpret_cast<sockaddr *>(&bound), &len) == 0)
+		g_port = ntohs(bound.sin_port);
+	else
+		g_port = port;
+	return true;
+}
+
+
+void close()
+{
+	if (g_socket != BAD_SOCKET)
+	{
+		flush_delayed();
+#ifdef _WIN32
+		::closesocket(g_socket);
+#else
+		::close(g_socket);
+#endif
+		g_socket = BAD_SOCKET;
+	}
+	g_delayed.clear();
+	g_port = 0;
+}
+
+
+uint16_t local_port()
+{
+	return g_port;
+}
+
+
+bool send(const endpoint &to, const void *data, size_t size)
+{
+	if (g_sim_loss > 0 && int(g_rng() % 100) < g_sim_loss)
+		return true;
+	if (g_sim_delay > 0 || g_sim_jitter > 0)
+	{
+		int jitter = g_sim_jitter > 0 ? int(g_rng() % uint32_t(g_sim_jitter + 1)) : 0;
+		uint32_t due = now_ms() + uint32_t(g_sim_delay + jitter);
+		// a fila fica em ordem de saída (a variação pode reordenar, como na internet)
+		auto it = g_delayed.end();
+		while (it != g_delayed.begin() && int32_t((it - 1)->due - due) > 0)
+			--it;
+		g_delayed.insert(it, delayed_packet{ due, to, std::vector<uint8_t>(reinterpret_cast<const uint8_t *>(data), reinterpret_cast<const uint8_t *>(data) + size) });
+		flush_delayed();
+		return true;
+	}
+	return raw_send(to, data, size);
+}
+
+
+int receive(endpoint &from, void *buffer, size_t size)
+{
+	if (!g_delayed.empty())
+		flush_delayed();
+	if (g_socket == BAD_SOCKET)
+		return -1;
+	sockaddr_in addr;
+	socklen_t len = sizeof(addr);
+	int const got = ::recvfrom(g_socket, reinterpret_cast<char *>(buffer), int(size), 0, reinterpret_cast<sockaddr *>(&addr), &len);
+	if (got < 0)
+		return -1;
+	from.ip = ntohl(addr.sin_addr.s_addr);
+	from.port = ntohs(addr.sin_port);
+	return got;
+}
+
+
+bool parse(const std::string &text, endpoint &out)
+{
+	size_t const colon = text.rfind(':');
+	if (colon == std::string::npos || colon == 0)
+		return false;
+	std::string const host = text.substr(0, colon);
+	int const port = std::atoi(text.c_str() + colon + 1);
+	if (port <= 0 || port > 65535)
+		return false;
+
+	in_addr addr;
+	if (inet_pton(AF_INET, host.c_str(), &addr) == 1)
+	{
+		out.ip = ntohl(addr.s_addr);
+		out.port = uint16_t(port);
+		return out.valid();
+	}
+
+#ifdef _WIN32
+	if (!g_wsa)
+	{
+		WSADATA wsa;
+		if (WSAStartup(MAKEWORD(2, 2), &wsa) == 0)
+			g_wsa = true;
+	}
+#endif
+	addrinfo hints;
+	std::memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_DGRAM;
+	addrinfo *result = nullptr;
+	if (getaddrinfo(host.c_str(), nullptr, &hints, &result) != 0 || !result)
+		return false;
+	out.ip = ntohl(reinterpret_cast<sockaddr_in *>(result->ai_addr)->sin_addr.s_addr);
+	out.port = uint16_t(port);
+	freeaddrinfo(result);
+	return out.valid();
+}
+
+
+std::vector<endpoint> parse_list(const std::string &text)
+{
+	std::vector<endpoint> result;
+	size_t start = 0;
+	while (start <= text.size())
+	{
+		size_t end = text.find_first_of(",; ", start);
+		if (end == std::string::npos)
+			end = text.size();
+		std::string const item = text.substr(start, end - start);
+		endpoint ep;
+		if (!item.empty() && parse(item, ep))
+		{
+			bool repeated = false;
+			for (const endpoint &other : result)
+				repeated = repeated || other == ep;
+			if (!repeated)
+				result.push_back(ep);
+		}
+		start = end + 1;
+	}
+	return result;
+}
+
+
+std::string to_string(const endpoint &ep)
+{
+	char text[32];
+	std::snprintf(text, sizeof(text), "%u.%u.%u.%u:%u", (ep.ip >> 24) & 0xff, (ep.ip >> 16) & 0xff, (ep.ip >> 8) & 0xff, ep.ip & 0xff, ep.port);
+	return text;
+}
+
+
+void simulate(int delay_ms, int jitter_ms, int loss_percent)
+{
+	g_sim_delay = delay_ms > 0 ? delay_ms : 0;
+	g_sim_jitter = jitter_ms > 0 ? jitter_ms : 0;
+	g_sim_loss = loss_percent > 0 ? (loss_percent > 90 ? 90 : loss_percent) : 0;
+}
+
+
+uint32_t now_ms()
+{
+	return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - g_clock_start).count());
+}
+
+
+void sleep_us(int64_t us)
+{
+	if (us <= 0)
+		return;
+	auto const until = std::chrono::steady_clock::now() + std::chrono::microseconds(us);
+	// a parte longa dorme; o último 1,5 ms é de espera ativa, para não passar do ponto
+	if (us > 2000)
+		std::this_thread::sleep_for(std::chrono::microseconds(us - 1500));
+	while (std::chrono::steady_clock::now() < until)
+		std::this_thread::yield();
+}
+
+void idle_ms(int ms)
+{
+	if (ms > 0)
+		std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+}
+
+} // namespace shmupx_netplay::net
