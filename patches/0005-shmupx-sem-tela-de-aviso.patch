diff --git a/src/frontend/mame/ui/ui.cpp b/src/frontend/mame/ui/ui.cpp
index bb901b5..f04d74f 100644
--- a/src/frontend/mame/ui/ui.cpp
+++ b/src/frontend/mame/ui/ui.cpp
@@ -670,6 +670,13 @@ void mame_ui_manager::display_startup_screens(bool first_time)
 	if (!first_time || (str > 0 && str < 60*5) || &machine().system() == &GAME_NAME(___empty) || (machine().debug_flags & DEBUG_FLAG_ENABLED) || video_none)
 		show_gameinfo = show_warnings = false;
 
+	// ShmupX: o jogo abre direto (na partida ranked, já no estado inicial), sem a tela de aviso de
+	// emulação imperfeita ou ROM ruim, que pede uma tecla. O Client só abre jogos certificados; o
+	// aviso vai para o log do Client (saída de erro).
+	if (show_warnings && machine_info().has_warnings())
+		osd_printf_warning("%s\n", machine_info().warnings_string());
+	show_warnings = false;
+
 #if defined(__EMSCRIPTEN__)
 	// also disable for the JavaScript port since the startup screens do not run asynchronously
 	show_gameinfo = show_warnings = false;
