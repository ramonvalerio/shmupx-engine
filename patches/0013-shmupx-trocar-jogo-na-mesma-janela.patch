+//-------------------------------------------------
+//  revert_shmupx_ranked - ShmupX: desfaz as travas
+//  da partida valendo ranking ao trocar de jogo no
+//  mesmo processo (o jogo seguinte pode ser treino)
+//-------------------------------------------------
+
+void emu_options::revert_shmupx_ranked()
+{
+	for (auto const &[name, value] : s_shmupx_ranked_locked)
+	{
+		auto entry = get_entry(name);
+		if (entry && entry->priority() == OPTION_PRIORITY_MAXIMUM)
+			entry->revert(OPTION_PRIORITY_MAXIMUM, OPTION_PRIORITY_MAXIMUM);
+	}
+	auto tolerance = get_entry("sync_refresh_tolerance");
+	if (tolerance && tolerance->priority() == OPTION_PRIORITY_MAXIMUM)
+		tolerance->revert(OPTION_PRIORITY_MAXIMUM, OPTION_PRIORITY_MAXIMUM);
+}
