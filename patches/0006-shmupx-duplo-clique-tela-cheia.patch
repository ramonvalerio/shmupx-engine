+//============================================================
+//  shmupx_double_click
+//  ShmupX: dois cliques do botão esquerdo na janela do jogo, no
+//  tempo e na distância de duplo clique do Windows.
+//============================================================
+
+static bool shmupx_double_click(HWND wnd, DWORD time, LPARAM lparam)
+{
+	static HWND last_wnd = nullptr;
+	static DWORD last_time = 0;
+	static POINT last_pos = { 0, 0 };
+	POINT const pos = { GET_X_LPARAM(lparam), GET_Y_LPARAM(lparam) };
+	bool const twice = wnd == last_wnd
+			&& (time - last_time) <= GetDoubleClickTime()
+			&& std::abs(pos.x - last_pos.x) <= GetSystemMetrics(SM_CXDOUBLECLK) / 2
+			&& std::abs(pos.y - last_pos.y) <= GetSystemMetrics(SM_CYDOUBLECLK) / 2;
+	// Depois de um duplo clique, o terceiro clique começa outro par (não alterna de novo).
+	last_wnd = twice ? nullptr : wnd;
+	last_time = time;
+	last_pos = pos;
+	return twice;
+}
+
+
+
