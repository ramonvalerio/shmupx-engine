 	{ OPTION_NO_PLUGIN,                                  nullptr,     core_options::option_type::STRING,     "list of plugins to disable" },
 
+	{ nullptr,                                           nullptr,     core_options::option_type::HEADER,     "SHMUPX OPTIONS" },
+	{ OPTION_SHMUPX_RANKED,                              "0",         core_options::option_type::BOOLEAN,    "ShmupX ranked match: original speed, default settings, no save states, cheats, menus or scripts" },
+
 	{ nullptr,                                           nullptr,     core_options::option_type::HEADER,     "HTTP SERVER OPTIONS" },
 	{ OPTION_HTTP,                                       "0",         core_options::option_type::BOOLEAN,    "enable HTTP server" },
 	{ OPTION_HTTP_PORT,                                  "8080",      core_options::option_type::INTEGER,    "HTTP server port" },
@@ -1344,3 +1347,50 @@ core_options::entry::shared_ptr image_option::setup_option_entry(std::vector<std
 	m_entry = entry;
 	return entry;
 }
+
+
+//-------------------------------------------------
+//  apply_shmupx_ranked - ShmupX: partida valendo
+//  ranking. Trava, com prioridade máxima (nenhum
+//  INI ou linha de comando passa por cima), tudo o
+//  que mudaria a partida: velocidade, save states,
+//  cheats, depurador, scripts e BIOS alternativas.
+//-------------------------------------------------
+
+void emu_options::apply_shmupx_ranked()
+{
+	static const std::pair<const char *, const char *> s_locked[] =
+	{
+		// velocidade original, sem pular quadros
+		{ OPTION_THROTTLE,           "1" },
+		{ OPTION_SPEED,              "1.0" },
+		{ OPTION_REFRESHSPEED,       "0" },
+		{ OPTION_FRAMESKIP,          "0" },
+		{ OPTION_AUTOFRAMESKIP,      "0" },
+		// sem estados salvos nem retrocesso
+		{ OPTION_STATE,              "" },
+		{ OPTION_AUTOSAVE,           "0" },
+		{ OPTION_REWIND,             "0" },
+		// configurações da placa no padrão: BIOS padrão e NVRAM nova a cada partida
+		{ OPTION_BIOS,               "" },
+		{ OPTION_NVRAM_SAVE,         "0" },
+		// sem cheats, depurador, console, scripts ou servidor HTTP
+		{ OPTION_CHEAT,              "0" },
+		{ OPTION_DEBUG,              "0" },
+		{ OPTION_CONSOLE,            "0" },
+		{ OPTION_AUTOBOOT_SCRIPT,    "" },
+		{ OPTION_AUTOBOOT_COMMAND,   "" },
+		{ OPTION_HTTP,               "0" },
+		// só o plugin de telemetria do ShmupX
+		{ OPTION_PLUGINS,            "1" },
+		{ OPTION_PLUGIN,             "shmupx" },
+		{ OPTION_NO_PLUGIN,          "" },
+	};
+	for (auto const &[name, value] : s_locked)
+		set_value(name, value, OPTION_PRIORITY_MAXIMUM);
+
+	// GroovyMAME: sincronizar com o monitor só se a frequência dele for a do jogo (no máximo 0,05 Hz de
+	// diferença, ~0,08% de velocidade); fora disso o jogo roda na velocidade original pelo relógio.
+	if (get_entry("sync_refresh_tolerance"))
+		set_value("sync_refresh_tolerance", "0.05", OPTION_PRIORITY_MAXIMUM);
+}
