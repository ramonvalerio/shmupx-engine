+//-------------------------------------------------
+//  shmupx_player_control - ShmupX: o campo é um
+//  controle do jogador 1 (direcional, botão ou start)
+//-------------------------------------------------
+
+static bool shmupx_player_control(ioport_field const &field)
+{
+	ioport_type const type = field.type();
+	if (type == IPT_START1)
+		return true;
+	if (field.player() != 0)
+		return false;
+	return (type > IPT_DIGITAL_JOYSTICK_FIRST && type < IPT_DIGITAL_JOYSTICK_LAST) || (type >= IPT_BUTTON1 && type <= IPT_BUTTON16);
+}
