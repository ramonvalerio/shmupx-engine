+struct item_region
+{
+	uint8_t *data;
+	size_t size;
+};
+std::vector<item_region> g_regions;
+uint8_t g_state_header[32];
+bool g_direct_copy = false;
+
+void copy_out(uint8_t *p)
+{
+	std::memcpy(p, g_state_header, sizeof(g_state_header));
+	p += sizeof(g_state_header);
+	for (item_region const &region : g_regions)
+	{
+		std::memcpy(p, region.data, region.size);
+		p += region.size;
+	}
+}
+
+void copy_in(const uint8_t *p)
+{
+	p += sizeof(g_state_header);
+	for (item_region const &region : g_regions)
+	{
+		std::memcpy(region.data, p, region.size);
+		p += region.size;
+	}
+}
+
+void build_regions(running_machine &machine)
+{
+	g_regions.clear();
+	g_direct_copy = false;
+	for (int i = 0; i < machine.save().registration_count(); i++)
+	{
+		void *base;
+		u32 valsize, valcount, blockcount, stride;
+		if (!machine.save().indexed_item(i, base, valsize, valcount, blockcount, stride))
+			continue;
+		size_t const size = size_t(valsize) * valcount;
+		uint8_t *data = reinterpret_cast<uint8_t *>(base);
+		for (u32 b = 0; b < blockcount; b++, data += stride)
+		{
+			if (!g_regions.empty() && g_regions.back().data + g_regions.back().size == data)
+				g_regions.back().size += size;
+			else
+				g_regions.push_back({ data, size });
+		}
+	}
+	std::vector<uint8_t> reference(g.state_size), direct(g.state_size);
+	if (machine.save().write_buffer(reference.data(), g.state_size) != STATERR_NONE)
+		return;
+	std::memcpy(g_state_header, reference.data(), sizeof(g_state_header));
+	copy_out(direct.data());
+	g_direct_copy = reference == direct;
+}
