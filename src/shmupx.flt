// Drivers compilados no ShmupX Engine (copiado para src/mame/shmupx.flt no build: SUBTARGET=shmupx).
// Um arquivo-fonte por linha, relativo a src/mame. Cada fonte traz todos os jogos dele (pais e clones).
// Jogo novo no catálogo: achar a fonte dele no mame.lst (@source:...) e incluir aqui.

atlus/cave.cpp                  // DoDonPachi, ESP Ra.De., Guwange, Mazinger Z
capcom/cps1.cpp                 // Carrier Air Wing
capcom/cps2.cpp                 // Dimahoo, Progear, 19XX, 1944, Giga Wing, Mars Matrix
cave/cv1k.cpp                   // Espgaluda II
cave/cv1k_v_blit*.cpp           // (desenho de sprites da CV1000, em arquivos à parte)
igs/pgm.cpp                     // Ketsui, Espgaluda, DoDonPachi Dai-Ou-Jou (e Black Label)
irem/m72.cpp                    // R-Type, R-Type II, Air Duel
irem/m92.cpp                    // R-Type Leo
kaneko/airbustr.cpp             // Air Buster
nec/pce.cpp                     // PC Engine / TurboGrafx-16 / SuperGrafx, HuCard (console: o cartucho vem por -cart)
konami/gradius3.cpp             // Gradius III
nintendo/nes.cpp                // NES / Famicom (console: o cartucho vem por -cart)
nintendo/snes.cpp               // Super Nintendo (console: o cartucho vem por -cart)
psikyo/psikyo.cpp               // Gunbird, Samurai Aces
psikyo/psikyosh.cpp             // Gunbird 2
sega/mdconsole.cpp              // Mega Drive / Genesis (console: o cartucho vem por -cart)
sega/stv.cpp                    // ST-V: Shienryu, Cotton 2, Cotton Boomerang (e o BIOS stvbios)
seibu/raiden.cpp                // Raiden
seibu/raiden2.cpp               // Raiden II, Raiden DX
snk/neogeo.cpp                  // Aero Fighters 2, Blazing Star, Zed Blade (e o BIOS da Neo Geo)
taito/taito_f3.cpp              // Darius Gaiden
toaplan/batsugun.cpp            // Batsugun
toaplan/raizing.cpp             // Battle Garegga
toaplan/raizing_batrider.cpp    // Armed Police Batrider
toaplan/toaplan1.cpp            // Truxton
toaplan/truxton2.cpp            // Truxton II
toaplan/vfive.cpp               // Grind Stormer
vsystem/aerofgt.cpp             // Aero Fighters
vsystem/pspikes.cpp             // Sonic Wings
